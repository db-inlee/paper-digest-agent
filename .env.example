# =============================================================================
# Paper Digest Agent - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# LLM API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# LangSmith (optional, for tracing)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=paper-digest-agent
LANGSMITH_TRACING=true

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL_CLAUDE=claude-sonnet-4-20250514
LLM_MODEL_OPENAI=gpt-4o

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Optional overrides
# Storage paths. Each defaults to <BASE_DIR>/<name>; BASE_DIR itself defaults to
# the repository root. Set these when the process runs in a container so that
# papers/ and index/ land on a mounted volume instead of the container filesystem.
# BASE_DIR=.
# REPORT_BASE_DIR=./reports
# PAPERS_BASE_DIR=./papers
# INDEX_BASE_DIR=./index

# Deep candidate selection by relative ranking (one gpt-4o-mini call per run).
# LLM listwise 순위가 위치 편향(입력 순서 추종)으로 판명되어 프롬프트 재설계 전까지 기본 off.
# Off falls back to the legacy interest_score / arxiv_id ordering.
# RANKING_ENABLED=false

# Trend briefing section at the top of the daily report.
# Deterministic counting over the stored skim window - no LLM calls.
# TREND_SECTION_ENABLED=true
# TREND_WINDOW_DAYS=7
# TREND_TOP_TAGS=5
# TREND_MIN_COUNT=2
# SCHEDULER_ENABLED=false
# SCHEDULER_CRON_HOUR=9
# SCHEDULER_TIMEZONE=Asia/Seoul
